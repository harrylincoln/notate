{
  "name": "notate",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "dev": "npm start",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "cypress:CI": "start-server-and-test preview http://127.0.0.1:3000 cypress:run",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.6",
    "typescript": "~6.0.0",
    "vue-tsc": "^3.3.14",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-vue": "^10.12.0",
    "typescript-eslint": "^8.72.1",
    "@types/node": "^24.0.0",
    "cypress": "^16.2.1",
    "start-server-and-test": "^3.0.13",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/client-cloudfront": "^3.1162.0",
    "dotenv": "^18.0.9",
    "mime-types": "^3.0.2"
  }
}
